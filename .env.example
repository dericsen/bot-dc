# Salin file ini jadi ".env" lalu isi dengan data punyamu
DISCORD_TOKEN=isi_token_bot_dari_discord_developer_portal
CLIENT_ID=isi_application_id_bot
GUILD_ID=isi_id_server_untuk_testing_command_lebih_cepat

# ID channel tempat welcome card dikirim (klik kanan channel > Copy Channel ID)
WELCOME_CHANNEL_ID=isi_id_channel_welcome

# ID role yang boleh pakai /lomba tambah dan /lomba hapus (opsional,
# Administrator selalu boleh terlepas dari ini)
ADMIN_ROLE_ID=

# ===== Auto-role per level (opsional) =====
# Isi dengan ID role masing-masing (klik kanan role di Server Settings > Roles).
# Kosongkan kalau tidak mau pakai fitur ini untuk level tersebut.
AUTOROLE_LEVEL_5=
AUTOROLE_LEVEL_10=
AUTOROLE_LEVEL_20=

# ===== GitHub Webhook -> Discord (opsional) =====
# 1. Generate secret sendiri, contoh: openssl rand -hex 20
# 2. Di repo GitHub: Settings > Webhooks > Add webhook
#    - Payload URL: http://ALAMAT_PUBLIK_KAMU:PORT/github/webhook
#      (kalau dev di localhost, pakai ngrok/cloudflared dulu supaya ada URL publik)
#    - Content type: application/json
#    - Secret: samain dengan GITHUB_WEBHOOK_SECRET di bawah
#    - Events: pilih Push, Pull requests, Issues, dll sesuai kebutuhan
GITHUB_WEBHOOK_SECRET=
GITHUB_CHANNEL_ID=
GITHUB_WEBHOOK_PORT=3000
